    <axis xyz="0 0 -1" />
    <limit lower="-3.14" upper="3.14" effort="0" velocity="0" />
  </joint>
  <joint name="left_shoulder_lift" type="revolute">
    <origin xyz="0 -0.029035 0.058223" rpy="0 1.5708 0" />
    <parent link="left_Rotation_Pitch" />
    <child link="left_Upper_Arm" />
    <axis xyz="0 0 -1" />
    <limit lower="-3.14" upper="3.14" effort="0" velocity="0" />
  </joint>
  <joint name="left_elbow_flex" type="revolute">
    <origin xyz="-0.041170749065642 0.128514358904429 0" rpy="0 0 0" />
    <parent link="left_Upper_Arm" />
    <child link="left_Lower_Arm" />
    <axis xyz="0 0 -1" />
    <limit lower="-3.14" upper="3.14" effort="0" velocity="0" />
  </joint>
  <joint name="left_wrist_flex" type="revolute">
    <origin xyz="0.00320470342874501 -0.198428485161884 0" rpy="0 0 0" />
