<?xml version="1.0" encoding="utf-8"?>
<robot name="am_arm200">
  <!-- Derived from am-arm200pro.urdf (https://github.com/liyiteng/AM-ARM, commit 5b03af1ef6c80595bd988e0137cf8e7c35811eb6, sha256 c38669d46d2bf804c112a6d8ce926074c8ff65ba70917503e09b77c75e285030). Stripped: inertial properties, visual/collision mesh references, inactive gripper/camera joints and links. Retained: full 6-DOF kinematic chain (link/joint origins, axes, limits). -->
  <link name="left_Base" />
  <link name="left_Rotation_Pitch" />
  <link name="left_Upper_Arm" />
  <link name="left_Lower_Arm" />
  <link name="left_Wrist_Pitch_Roll" />
  <link name="left_wrist_yaw" />
  <link name="left_Fixed_Jaw" />
  <joint name="left_shoulder_pan" type="revolute">
    <origin xyz="0 0 0.062556" rpy="0 0 0" />
