    <child link="left_Wrist_Pitch_Roll" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="0" velocity="0" />
  </joint>
  <joint name="left_wrist_yaw_joint" type="revolute">
    <origin xyz="-0.000915704840558335 -0.0281295188165527 -0.000966380385420608" rpy="3.14159257760848 1.5707963267949 0" />
